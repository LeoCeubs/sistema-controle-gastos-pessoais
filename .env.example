# Copie para .env e ajuste se precisar. Sem .env, valem os padroes abaixo.
# Lido pelo docker compose; a execucao sem Docker usa variaveis do shell.

# Porta do host para acessar a aplicacao (http://localhost:PORTA)
PORTA=8000

# Banco SQLite. No Docker, mantenha dentro de /app/data (volume `dados`) ou os dados
# somem ao recriar o container.
DATABASE_URL=sqlite:////app/data/app.db
